---
import { withBase } from "../lib/base";

const links = [
  { href: "/", label: "首页" },
  { href: "/design/", label: "设计参考" },
  { href: "/knowledge/", label: "知识库" },
  { href: "/tutorials/", label: "教程" },
  { href: "/resources/", label: "资源" },
  { href: "/glossary/", label: "术语" },
  { href: "/about/", label: "关于" },
];
---
<div id="menu-scrim" class="menu-scrim"></div>
<nav id="mobile-menu" class="mobile-menu" aria-label="移动端导航">
  {
    links.map((l) => (
      <a href={withBase(l.href)}>{l.label}</a>
    ))
  }
</nav>

<script>
  import { animate } from "motion";
  const menu = document.getElementById("mobile-menu")!;
  const scrim = document.getElementById("menu-scrim")!;
  const toggle = document.getElementById("menu-toggle");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function open() {
    menu.classList.add("open");
    scrim.classList.add("open");
    if (!reduced) {
      animate(menu, { x: 0 }, { type: "spring", bounce: 0.2, duration: 0.5 });
      animate(scrim, { opacity: 1 }, { duration: 0.25 });
    }
    document.body.style.overflow = "hidden";
  }
  function close() {
    if (!reduced) {
      animate(menu, { x: "100%" }, { type: "spring", bounce: 0, duration: 0.35 });
      animate(scrim, { opacity: 0 }, { duration: 0.2 });
    }
    menu.classList.remove("open");
    scrim.classList.remove("open");
    document.body.style.overflow = "";
  }
  toggle?.addEventListener("click", () => (menu.classList.contains("open") ? close() : open()));
  scrim.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>
