---
const { delay = 0, as = "div" } = Astro.props;
const Tag = as as any;
---
<Tag class="reveal" data-delay={delay}><slot /></Tag>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    const els = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          const delayMs = Number(el.getAttribute("data-delay") || 0);
          el.animate(
            [
              { opacity: 0, transform: "translateY(18px)" },
              { opacity: 1, transform: "none" },
            ],
            {
              duration: 600,
              delay: delayMs,
              easing: "cubic-bezier(0.22, 1, 0.36, 1)",
              fill: "both",
            }
          );
          el.classList.add("visible");
          io.unobserve(el);
        }
      },
      { threshold: 0.15 }
    );
    els.forEach((el) => io.observe(el));
  } else {
    document.querySelectorAll<HTMLElement>(".reveal").forEach((el) => el.classList.add("visible"));
  }
</script>
