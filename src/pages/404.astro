---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/base";
---
<Base title="页面未找到">
  <section class="hero">
    <div class="container">
      <h1>404</h1>
      <p class="hero__lead">这个页面不存在或已被移动。</p>
      <div class="hero__actions">
        <a class="btn" href={withBase("/")}>回到首页</a>
        <a class="btn btn--ghost" href={withBase("/knowledge/")}>浏览知识库</a>
      </div>
    </div>
  </section>
</Base>
