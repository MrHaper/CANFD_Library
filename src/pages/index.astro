---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import Reveal from "../components/Reveal.astro";
import { withBase } from "../lib/base";

const design = await getCollection("design");
const knowledge = await getCollection("knowledge");
const tutorials = await getCollection("tutorials");
const glossary = await getCollection("glossary");
const resources = await getCollection("resources");

const knowledgeIndexes = knowledge
  .filter((e) => e.id !== "index" && !e.id.includes("/"))
  .map((e) => ({
    title: e.data.title,
    description: e.data.description || "",
    url: `/knowledge/${e.id}/`,
    section: e.id.split("/")[0],
  }));

const tutorialList = tutorials
  .filter((e) => !e.id.endsWith("/index") && e.id !== "index")
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((e) => ({
    title: e.data.title,
    description: e.data.description || "",
    url: `/tutorials/${e.id.replace(/\.md$/, "")}/`,
    difficulty: (e.data.tags || [])[0] || "",
  }));

const resourceCats: Record<string, { label: string; count: number; url: string }> = {};
for (const e of resources) {
  const cat = e.id.split("/")[0];
  if (!resourceCats[cat]) {
    resourceCats[cat] = { label: cat, count: 0, url: `/resources/${cat}/` };
  }
  resourceCats[cat].count++;
}
const resourceList = Object.values(resourceCats).sort((a, b) => b.count - a.count);

const designPages = design
  .filter((e) => !e.id.endsWith("/index") && e.id !== "index")
  .map((e) => ({
    title: e.data.title,
    description: e.data.description || "",
    url: `/design/${e.id.replace(/\.md$/, "")}/`,
  }));
---
<Base title="CAN FD 知识库" description="面向模拟 IC 设计工程师的 CAN FD / CAN SIC 中文知识库:协议、位定时、物理层、收发器设计、测试认证与资源索引。">
  <section class="hero">
    <div class="container">
      <Reveal>
        <span class="hero__eyebrow">面向模拟 IC 设计工程师</span>
        <h1>CAN FD / CAN SIC<br />从协议到芯片的完整知识库</h1>
        <p class="hero__lead">
          聚合 ISO 标准、专利、论文、数据手册与工程经验,覆盖协议、位定时、物理层、收发器模块设计、测试认证与资源索引。
        </p>
        <div class="hero__actions">
          <a class="btn" href={withBase("/design/")}>进入设计参考</a>
          <a class="btn btn--ghost" href={withBase("/knowledge/")}>浏览知识库</a>
        </div>
      </Reveal>
      <Reveal delay={120}>
        <div class="stat-row" style="margin-top:3rem;">
          <div class="stat"><div class="stat__num">{designPages.length + knowledge.length}</div><div class="stat__label">设计参考 + 知识点</div></div>
          <div class="stat"><div class="stat__num">{tutorialList.length}</div><div class="stat__label">原创教程</div></div>
          <div class="stat"><div class="stat__num">{resources.length}</div><div class="stat__label">资源条目</div></div>
          <div class="stat"><div class="stat__num">{glossary.length}</div><div class="stat__label">术语词条</div></div>
        </div>
      </Reveal>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <Reveal>
        <div class="section__head">
          <h2>设计参考</h2>
          <a class="section__link" href={withBase("/design/")}>全部模块 →</a>
        </div>
      </Reveal>
      <div class="card-grid">
        {
          designPages.slice(0, 6).map((p, i) => (
            <Reveal delay={i * 60}>
              <a class="card" href={withBase(p.url)}>
                <div class="card__icon">⚙</div>
                <h3>{p.title}</h3>
                <p>{p.description}</p>
              </a>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Reveal>
        <div class="section__head">
          <h2>SIC 专题</h2>
          <a class="section__link" href={withBase("/sic/")}>打开专题 →</a>
        </div>
      </Reveal>
      <Reveal>
        <a class="card" href={withBase("/sic/")}>
          <div class="card__icon">⚡</div>
          <h3>CAN SIC 收发器完整专题</h3>
          <p>振铃机理、三方面改进、关键参数、芯片架构、振铃抑制电路与测试验证,22 张原创技术图整合为一页。</p>
        </a>
      </Reveal>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Reveal>
        <div class="section__head">
          <h2>知识库</h2>
          <a class="section__link" href={withBase("/knowledge/")}>全部子域 →</a>
        </div>
      </Reveal>
      <div class="card-grid">
        {
          knowledgeIndexes.map((k, i) => (
            <Reveal delay={(i % 3) * 70}>
              <a class="card" href={withBase(k.url)}>
                <div class="card__icon">📘</div>
                <h3>{k.title.replace(/总览$/, "")}</h3>
                <p>{k.description}</p>
              </a>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Reveal>
        <div class="section__head">
          <h2>教材与基础</h2>
          <a class="section__link" href={withBase("/knowledge/transceiver-design/analog-ic-textbooks/")}>知识地图 →</a>
        </div>
      </Reveal>
      <Reveal>
        <a class="card" href={withBase("/knowledge/transceiver-design/analog-ic-textbooks/")}>
          <div class="card__icon">📖</div>
          <h3>模拟 IC 设计教材知识总结</h3>
          <p>器件工艺、放大器/比较器、输出级、ESD/闩锁、版图与噪声——按收发器模块映射经典教材章节。</p>
        </a>
      </Reveal>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <Reveal>
        <div class="section__head">
          <h2>教程</h2>
          <a class="section__link" href={withBase("/tutorials/")}>全部教程 →</a>
        </div>
      </Reveal>
      <div class="card-grid">
        {
          tutorialList.slice(0, 6).map((t, i) => (
            <Reveal delay={i * 60}>
              <a class="card" href={withBase(t.url)}>
                <div class="card__icon">🛠</div>
                <h3>{t.title}</h3>
                <p>{t.description}</p>
                {t.difficulty && <div class="card__meta">{t.difficulty}</div>}
              </a>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Reveal>
        <div class="section__head">
          <h2>资源库</h2>
          <a class="section__link" href={withBase("/resources/")}>全部资源 →</a>
        </div>
      </Reveal>
      <div class="card-grid">
        {
          resourceList.map((r, i) => (
            <Reveal delay={(i % 3) * 70}>
              <a class="card" href={withBase(r.url)}>
                <div class="card__icon">📄</div>
                <h3>{r.label}</h3>
                <p>{r.count} 条收录资料</p>
              </a>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>
</Base>
